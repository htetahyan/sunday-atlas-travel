# Cloudflare Pages cache headers.
# HTML and data revalidate on every request (ETag -> 304), so a deploy with
# added, edited or deleted text/images is visible immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed bundles: a new build gets new file names.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Decap CMS: never stale while editing.
/admin/*
  ! Cache-Control
  Cache-Control: no-store, no-cache, must-revalidate

/chat-index/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
/logo.png
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
